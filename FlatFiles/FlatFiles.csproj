<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageId>Cynicszm.FlatFiles</PackageId>
    <Authors>Cynicszm</Authors>
    <Description>Reads and writes CSV, fixed-length and other flat file formats with a focus on schema definition, configuration and speed. Supports mapping directly between files and classes. A fork of FlatFiles by Travis Parks, continued for .NET 10; the assembly and namespaces are unchanged, so only the package reference differs.</Description>
    <PackageProjectUrl>https://github.com/Cynicszm/FlatFiles</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cynicszm/FlatFiles.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csv;comma;tab;separated;value;delimited;flat;file;fixed;width;fixed-width;length;fixed-length;parser;parsing;parse</PackageTags>
    <PackageReleaseNotes>Writers now format each record into one reusable buffer and hand it to the TextWriter in a single write, removing half to two thirds of the allocation from writing a file and making every writer a little faster. The text written is unchanged. New Format(IColumnContext?, object?, IBufferWriter&lt;char&gt;) overloads on IColumnDefinition and ColumnDefinition, with a default that falls back to the string form, so existing custom columns keep working; override the buffer overload to format without a string.</PackageReleaseNotes>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FlatFiles.snk</AssemblyOriginatorKeyFile>
    <Version>7.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>7.1.0.0</AssemblyVersion>
    <FileVersion>7.1.0.0</FileVersion>
    <PackageLicenseFile>UNLICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\UNLICENSE.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
