<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageId>Cynicszm.FlatFiles</PackageId>
    <Authors>Cynicszm</Authors>
    <Description>Reads and writes CSV, fixed-length and other flat file formats with a focus on schema definition, configuration and speed. Supports mapping directly between files and classes. A fork of FlatFiles by Travis Parks, continued for .NET 10. The assembly and namespaces are unchanged, and through 7.6.0 every type and member name was too, so only the package reference differed; 8.0.0 renames a few of them, each named in the changelog.</Description>
    <PackageProjectUrl>https://github.com/Cynicszm/FlatFiles</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cynicszm/FlatFiles.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csv;comma;tab;separated;value;delimited;flat;file;fixed;width;fixed-width;length;fixed-length;parser;parsing;parse</PackageTags>
    <PackageReleaseNotes>9.2.2 - A custom mapping given a reader and no writer took every other column in the mapping off the path that writes straight from an entity, because writing needs a getter for every column and none was built for one that never writes. Such a column now writes what it always wrote, a null, through its own column's Format so that its null formatter still decides what nothing looks like. This is the last corner of the defect fixed in 9.2.1. The build dependencies also move up - Microsoft.CodeAnalysis.CSharp to 5.9.0, the test SDK to 18.11.0 and MSTest to 4.5.1 - which raises the compiler a consuming project needs, since the source generator ships inside this package; a .NET 10 SDK already satisfies it. No API changes.</PackageReleaseNotes>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FlatFiles.snk</AssemblyOriginatorKeyFile>
    <Version>9.2.2</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Ships with the package: IntelliSense text, and a symbol package whose Source Link points at the commit. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Pack fails if the public API loses or changes a member relative to the last release, so a breaking
         change has to be declared here by moving the baseline, not discovered by a consumer. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>9.2.2</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>9.2.2.0</AssemblyVersion>
    <FileVersion>9.2.2.0</FileVersion>
    <PackageLicenseFile>UNLICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\UNLICENSE.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator is built before this package is packed, but nothing in the library refers to it:
         it runs inside the compiler, not beside the library. -->
    <ProjectReference Include="..\FlatFiles.Generator\FlatFiles.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <None Include="..\FlatFiles.Generator\bin\$(Configuration)\netstandard2.0\FlatFiles.Generator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <!-- Declares FlatFilesGenerateAccessors to the compiler, so the generator can be told to write nothing.
         build applies to a project that references this package; buildTransitive to one that gets it through
         another package. -->
    <None Include="build\Cynicszm.FlatFiles.props"
          Pack="true"
          PackagePath="build;buildTransitive" />
  </ItemGroup>

</Project>
