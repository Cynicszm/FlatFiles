<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageId>Cynicszm.FlatFiles</PackageId>
    <Authors>Cynicszm</Authors>
    <Description>Reads and writes CSV, fixed-length and other flat file formats with a focus on schema definition, configuration and speed. Supports mapping directly between files and classes. A fork of FlatFiles by Travis Parks, continued for .NET 10; the assembly and namespaces are unchanged, so only the package reference differs.</Description>
    <PackageProjectUrl>https://github.com/Cynicszm/FlatFiles</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cynicszm/FlatFiles.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csv;comma;tab;separated;value;delimited;flat;file;fixed;width;fixed-width;length;fixed-length;parser;parsing;parse</PackageTags>
    <PackageReleaseNotes>DateOnlyColumn and TimeOnlyColumn, with InputFormat, OutputFormat and FormatProvider; Property overloads on both type mappers for DateOnly, DateOnly?, TimeOnly and TimeOnly?, DateOnlyProperty and TimeOnlyProperty on the dynamic mappers, auto-mapping of both types, and GetDateOnly and GetTimeOnly on the data reader. Mappers now detect a runtime without dynamic code (Native AOT, or the IsDynamicCodeSupported switch off) and use reflection instead of Reflection.Emit, so a published AOT application maps entities without throwing. A column is given a ColumnContext only when a hook, a custom null formatter or default value, a complex column or a subclass could read it; errors still carry a full context. Typed reads allocate about a third less. The package carries the XML documentation for every public member and a symbol package with Source Link. Source-compatible with 7.3.0 and validated against it at pack time.</PackageReleaseNotes>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FlatFiles.snk</AssemblyOriginatorKeyFile>
    <Version>7.4.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Ships with the package: IntelliSense text, and a symbol package whose Source Link points at the commit. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Pack fails if the public API loses or changes a member relative to the last release, so a breaking
         change has to be declared here by moving the baseline, not discovered by a consumer. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>7.4.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>7.4.0.0</AssemblyVersion>
    <FileVersion>7.4.0.0</FileVersion>
    <PackageLicenseFile>UNLICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\UNLICENSE.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
